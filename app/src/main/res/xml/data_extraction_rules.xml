<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup rules.
   The notes database and app settings are left out of Google backup on purpose: notes come back
   after a reinstall from the audio files' embedded data and from Srutam Cloud, and a restored
   database would hold stale local ids and an "onboarding done" flag that skip the restore flow.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
