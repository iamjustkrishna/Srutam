<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_dock_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Collapsed Floating Pill -->
    <FrameLayout
        android:id="@+id/dock_collapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible">

        <ImageView
            android:id="@+id/floating_record_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_floating_mic"
            android:background="@drawable/bg_floating_dock"
            android:contentDescription="@string/floating_button_desc"
            android:elevation="12dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Expanded Options Menu (Idle / Not Recording) -->
    <LinearLayout
        android:id="@+id/dock_expanded_idle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_floating_dock_card"
        android:elevation="14dp"
        android:visibility="gone">

        <!-- Direct Start Recording Action -->
        <LinearLayout
            android:id="@+id/btn_dock_start_record"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_floating_record_circle"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_floating_mic"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="Record" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Record"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:clickable="false"
                android:focusable="false"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Open Srutam App -->
        <ImageView
            android:id="@+id/btn_dock_open_app"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:padding="9dp"
            android:background="@drawable/bg_floating_action_circle"
            android:src="@drawable/ic_floating_app"
            android:contentDescription="Open Srutam"
            android:clickable="true"
            android:focusable="true" />

        <!-- Collapse Dock -->
        <ImageView
            android:id="@+id/btn_dock_collapse"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:background="@drawable/bg_floating_action_circle"
            android:src="@drawable/ic_floating_close"
            android:contentDescription="Close"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Expanded In-Flight Recording Controls -->
    <LinearLayout
        android:id="@+id/dock_expanded_recording"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_floating_dock_card"
        android:elevation="14dp"
        android:visibility="gone">

        <!-- Live Duration Display -->
        <TextView
            android:id="@+id/txt_dock_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <!-- Pause / Resume Button -->
        <ImageView
            android:id="@+id/btn_dock_pause_resume"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:padding="9dp"
            android:background="@drawable/bg_floating_action_circle"
            android:src="@drawable/ic_floating_pause"
            android:contentDescription="Pause or Resume"
            android:clickable="true"
            android:focusable="true" />

        <!-- Stop & Save Button -->
        <ImageView
            android:id="@+id/btn_dock_stop_save"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:padding="9dp"
            android:background="@drawable/bg_floating_record_circle"
            android:src="@drawable/ic_floating_stop"
            android:contentDescription="Save Recording"
            android:clickable="true"
            android:focusable="true" />

        <!-- Cancel / Discard Recording Button -->
        <ImageView
            android:id="@+id/btn_dock_cancel"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="10dp"
            android:background="@drawable/bg_floating_action_circle"
            android:src="@drawable/ic_floating_close"
            android:contentDescription="Discard Recording"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</FrameLayout>
