{
  "name": "srutam-mcp",
  "version": "1.3.0",
  "description": "Model Context Protocol (MCP) server for Srutam - fetch voice notes, ideas, and action items inside AI coding agents (OpenCode, Cursor, Windsurf, Claude, Zed, Antigravity)",
  "main": "dist/index.js",
  "bin": {
    "srutam-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "srutam",
    "voice-notes",
    "ai-agent",
    "opencode",
    "cursor",
    "windsurf",
    "zed",
    "cline",
    "claude",
    "antigravity"
  ],
  "author": "Krishna (@iamjustkrishna)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@supabase/supabase-js": "^2.49.1",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamjustkrishna/Srutam.git",
    "directory": "mcp-server"
  }
}
