{
  "name": "srutam-mcp",
  "version": "1.4.0",
  "description": "Model Context Protocol (MCP) server for Srutam - fetch voice notes, ideas, and action items inside AI coding agents (Claude Code, Codex, Gemini CLI, Cursor, VS Code, Windsurf, OpenCode, Zed, Kiro and more)",
  "main": "dist/index.js",
  "bin": {
    "srutam-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "srutam",
    "voice-notes",
    "ai-agent",
    "opencode",
    "cursor",
    "windsurf",
    "zed",
    "cline",
    "claude",
    "antigravity",
    "codex",
    "gemini-cli",
    "kiro",
    "crush",
    "vscode",
    "copilot"
  ],
  "author": "Krishna (@iamjustkrishna)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@supabase/supabase-js": "^2.49.1",
    "jsonc-parser": "^3.3.1",
    "uqr": "0.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "jsqr": "1.4.0",
    "smol-toml": "^1.9.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamjustkrishna/Srutam.git",
    "directory": "mcp-server"
  }
}
